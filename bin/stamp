#!/usr/bin/env bash

# increment the version number, update CHANGELOG

set -euo pipefail
cd "$(dirname "$0")/.."

# everything must be staged and committed before releasing
if [ -n "$(git status --porcelain)" ]; then
  echo "error: working tree is not clean; commit or stash your changes first" >&2
  git status --short >&2
  exit 1
fi

# tests and cookbook lint must pass before releasing
if ! mix test; then
  echo "error: 'mix test' failed; aborting release" >&2
  exit 1
fi

if ! mix composer.cookbook.lint; then
  echo "error: 'mix composer.cookbook.lint' failed; aborting release" >&2
  exit 1
fi

# update the manifest, committing it if it changed
mix composer.cookbook.manifest

if [ -n "$(git status --porcelain)" ]; then
  git commit -am 'chore: Update the cookbook manifest'
fi

# release and push 
mix git_ops.release --yes --no-major && ./push 
